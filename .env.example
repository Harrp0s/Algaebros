# Copy to .env and fill in. Never commit .env. Never paste a key into a chat or a screenshot.

# Photon 2.0 (Beta). Create a project at https://app.photon.codes, then a project API key (pho_sk_...)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=

# Grok (xAI): the chat assistant, and its voice (speech in, speech out). Get a key at https://console.x.ai
XAI_API_KEY=
# Optional. Model names change quickly; if this one is rejected the app finds a valid one by itself and tells you.
# XAI_MODEL=grok-4.7
# Optional. Voice for spoken answers (default eve).
# XAI_VOICE=eve

# Daytona: sandboxes for the Forecast Lab and "Ask the data". Get a key at https://app.daytona.io, then: pip install daytona
DAYTONA_API_KEY=
# Optional. How many Forecast Lab sandboxes run at once (default 8). Lower it if Daytona says you hit a limit.
# DAYTONA_MAX_PARALLEL=8

# Capital One Nessie (hackathon banking API): cleanup-fund accounts and businesses near the water, in the Cleanup planner.
# Get a key at http://api.nessieisreal.com (log in with GitHub). Without it the planner keeps a local ledger instead.
NESSIE_API_KEY=

# Optional: where generated data lives (default: ./data)
# ALGAEBRO_DATA_DIR=./data
